# default base image
ARG REMOTE_APHRODITE="0"
ARG APHRODITE_REPO="https://github.com/aphrodite-engine/aphrodite-engine.git"
ARG APHRODITE_BRANCH="main"
ARG COMMON_WORKDIR=/app
# Pinned: the rocm/vllm-dev:base tag moved from /opt/rocm 7.2.3 to the ROCm SDK 10.0.0
# on 2026-10-18. When bumping, also bump the aphrodite-rocm-cmake-* cache id below
# and the rocm723 wheel label in the wheel workflows.
ARG BASE_IMAGE=rocm/vllm-dev:base@sha256:3cead535c32c11c59b222bbaa502076b9c737fb969b70b7bc9bb8ce77da5698e

# Sccache configuration (only used in release pipeline)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME=aphrodite-build-sccache
ARG SCCACHE_REGION_NAME=us-west-2
ARG SCCACHE_S3_NO_CREDENTIALS=0

FROM ${BASE_IMAGE} AS base

ARG ARG_PYTORCH_ROCM_ARCH
ENV PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH:-${PYTORCH_ROCM_ARCH}}
# Do not set MORI_GPU_ARCHS here; MoRI automatically infers it at runtime.

# Install basic utilities and ROCm build/runtime dependencies not guaranteed by
# the base image.
RUN apt-get update -q -y && apt-get install -q -y --no-install-recommends \
    sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev libsuitesparse-dev \
    apt-transport-https ca-certificates wget curl git libnuma-dev unzip ccache \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip

# Remove sccache only if not using sccache. The ROCm base images may already
# include it from their base-build stage.
ARG USE_SCCACHE
RUN if [ "$USE_SCCACHE" != "1" ]; then \
        apt-get purge -y sccache || true; \
        python3 -m pip uninstall -y sccache || true; \
        rm -f "$(which sccache)" || true; \
    fi

# Install uv. Download first, then run, so curl failures are not masked by a
# shell pipe.
RUN curl -LsSf --retry 3 --retry-delay 5 https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && env UV_INSTALL_DIR="/usr/local/bin" sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version

# This timeout is needed for some larger ROCm dependency downloads.
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_LINK_MODE=copy
ENV CCACHE_DIR=/root/.cache/ccache
ENV CCACHE_COMPILERCHECK=content
ENV CCACHE_MAXSIZE=80G
ENV CCACHE_COMPRESS=true

# Install sccache if USE_SCCACHE is enabled.
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME
ARG SCCACHE_REGION_NAME
ARG SCCACHE_S3_NO_CREDENTIALS
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        if command -v sccache >/dev/null 2>&1; then \
            echo "sccache already installed, skipping installation"; \
            sccache --version; \
        else \
            echo "Installing sccache..." \
            && SCCACHE_ARCH="x86_64" \
            && SCCACHE_VERSION="v0.8.1" \
            && SCCACHE_DL_URL="${SCCACHE_DOWNLOAD_URL:-https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl.tar.gz}" \
            && curl -L -o /tmp/sccache.tar.gz "${SCCACHE_DL_URL}" \
            && tar -xzf /tmp/sccache.tar.gz -C /tmp \
            && mv /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl/sccache /usr/bin/sccache \
            && chmod +x /usr/bin/sccache \
            && rm -rf /tmp/sccache.tar.gz /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl \
            && sccache --version; \
        fi; \
    fi

# Set sccache environment variables only when USE_SCCACHE=1. This prevents S3
# config from leaking into runtime images when sccache is not used.
ARG USE_SCCACHE
ENV SCCACHE_BUCKET=${USE_SCCACHE:+${SCCACHE_BUCKET_NAME}}
ENV SCCACHE_REGION=${USE_SCCACHE:+${SCCACHE_REGION_NAME}}
ENV SCCACHE_S3_NO_CREDENTIALS=${USE_SCCACHE:+${SCCACHE_S3_NO_CREDENTIALS}}
ENV SCCACHE_IDLE_TIMEOUT=${USE_SCCACHE:+0}

ARG COMMON_WORKDIR
WORKDIR ${COMMON_WORKDIR}


# -----------------------
# Aphrodite fetch stages
FROM base AS fetch_aphrodite_0
ONBUILD COPY ./ aphrodite/


FROM base AS fetch_aphrodite_1
ARG APHRODITE_REPO
ARG APHRODITE_BRANCH
ONBUILD RUN git clone ${APHRODITE_REPO} aphrodite \
    && cd aphrodite \
    && git fetch -v --prune -- origin ${APHRODITE_BRANCH} \
    && git checkout FETCH_HEAD \
    && if [ "${APHRODITE_REPO}" != "https://github.com/aphrodite-engine/aphrodite-engine.git" ]; then \
           git remote add upstream "https://github.com/aphrodite-engine/aphrodite-engine.git" \
           && git fetch upstream; \
       fi

FROM fetch_aphrodite_${REMOTE_APHRODITE} AS fetch_aphrodite


# -----------------------
# Rust build inputs
#
# REMOTE_APHRODITE=0: use only the local files that can affect Rust artifacts.
# REMOTE_APHRODITE=1: fetch only those same files from the requested remote ref.
FROM scratch AS rust_input_0
COPY requirements/build/rust.txt /rust-input/aphrodite/requirements/build/rust.txt
COPY rust/Cargo.lock rust/Cargo.toml /rust-input/aphrodite/rust/
COPY rust/proto /rust-input/aphrodite/rust/proto
COPY rust/src /rust-input/aphrodite/rust/src
COPY tools/build_rust.py /rust-input/aphrodite/tools/build_rust.py


FROM base AS rust_input_1
ARG APHRODITE_REPO
ARG APHRODITE_BRANCH
RUN git clone --no-checkout --filter=blob:none ${APHRODITE_REPO} /rust-input/aphrodite \
    && cd /rust-input/aphrodite \
    && git fetch -v --prune -- origin ${APHRODITE_BRANCH} \
    && git sparse-checkout init --no-cone \
    && git sparse-checkout set \
        requirements/build/rust.txt \
        rust/Cargo.lock \
        rust/Cargo.toml \
        rust/proto/** \
        rust/src/** \
        tools/build_rust.py \

    && git checkout FETCH_HEAD

FROM rust_input_${REMOTE_APHRODITE} AS rust-input


# -----------------------
# Rust build stage
# Builds Rust artifacts in a source-scoped stage so non-Rust Docker changes do
# not invalidate the cargo release build.
FROM base AS rust-build
ARG COMMON_WORKDIR
ARG USE_SCCACHE
ARG SCCACHE_ENDPOINT
ARG MAX_JOBS=4

# Cap cargo parallelism to avoid exhausting the AMD CI host's open-file limit
# (rustc spawns enough concurrent processes to hit RLIMIT_NOFILE otherwise).
ENV CARGO_BUILD_JOBS=4
ENV CARGO_NET_RETRY=10
ENV RUSTUP_MAX_RETRIES=10
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH=${CARGO_HOME}/bin:${PATH}

WORKDIR ${COMMON_WORKDIR}/aphrodite

COPY --from=rust-input /rust-input/aphrodite/requirements/build/rust.txt requirements/build/rust.txt

RUN apt-get update -q -y && apt-get install -q -y --no-install-recommends \
        protobuf-compiler libprotobuf-dev curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustc --version \
    && cargo --version

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements/build/rust.txt

COPY --from=rust-input /rust-input/aphrodite/rust rust
COPY --from=rust-input /rust-input/aphrodite/tools/build_rust.py tools/build_rust.py


# BuildKit can run this stage in parallel with ROCm native builds. Keep Rust on
# a separate local sccache daemon while sharing the same remote cache backend.
ENV SCCACHE_SERVER_PORT=4227

# Cargo's registry/git caches can be written by concurrent BuildKit jobs on
# shared workers, so lock those cache mounts while cargo is running.
RUN --mount=type=cache,id=aphrodite-rocm-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=aphrodite-rocm-cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=aphrodite-rocm-cargo-target,target=/app/aphrodite/rust/target,sharing=locked \
    if [ "$USE_SCCACHE" = "1" ]; then \
        if [ -n "${SCCACHE_ENDPOINT}" ]; then export SCCACHE_ENDPOINT="${SCCACHE_ENDPOINT}"; fi; \
        export RUSTC_WRAPPER=sccache; \
        sccache --show-stats; \
    fi \
    && python3 tools/build_rust.py --release \
    && if [ "$USE_SCCACHE" = "1" ]; then \
        sccache --show-stats; \
    fi


# -----------------------
# Aphrodite build stages
FROM fetch_aphrodite AS build_aphrodite
ARG USE_SCCACHE
ARG SCCACHE_ENDPOINT
ARG MAX_JOBS=12
ARG APHRODITE_VERSION_OVERRIDE=""
ENV MAX_JOBS=${MAX_JOBS}
ENV APHRODITE_VERSION_OVERRIDE=${APHRODITE_VERSION_OVERRIDE}

# Remove Rust artifacts copied from the host before adding the separately built
# versions. Build and distribution directories are excluded by .dockerignore.
RUN rm -f aphrodite/aphrodite/aphrodite-rs aphrodite/aphrodite/_rust_*.so

COPY --from=rust-build ${COMMON_WORKDIR}/aphrodite/aphrodite/aphrodite-rs aphrodite/aphrodite/aphrodite-rs
COPY --from=rust-build ${COMMON_WORKDIR}/aphrodite/aphrodite/_rust_*.so aphrodite/aphrodite/

# Build Aphrodite. setup.py auto-detects sccache in PATH.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,id=aphrodite-rocm-ccache,target=/root/.cache/ccache,sharing=locked \
    --mount=type=cache,id=aphrodite-rocm-cmake-v2,target=${COMMON_WORKDIR}/aphrodite/build,sharing=locked \
    --mount=type=cache,id=aphrodite-rocm-deps,target=${COMMON_WORKDIR}/aphrodite/.deps,sharing=locked \
    --mount=type=secret,id=aws-credentials,target=/root/.aws/credentials,required=false \
    cd aphrodite \
    && mkdir -p build \
    && find build -mindepth 1 -maxdepth 1 ! -name 'temp.*' -exec rm -rf {} + \
    && ccache --set-config=max_size=${CCACHE_MAXSIZE} \
    && ccache --show-stats \
    && if [ "$USE_SCCACHE" = "1" ]; then \
        if [ -n "${SCCACHE_ENDPOINT}" ]; then export SCCACHE_ENDPOINT="${SCCACHE_ENDPOINT}"; fi; \
        export RUSTC_WRAPPER=sccache; \
        sccache --show-stats; \
    fi \
    && uv pip install --system -r requirements/rocm.txt \
    && export APHRODITE_USE_PRECOMPILED_RUST=1 \
    && python3 setup.py bdist_wheel --dist-dir=dist --py-limited-api=cp38 \
    && ccache --show-stats \
    && if [ "$USE_SCCACHE" = "1" ]; then \
        sccache --show-stats; \
    fi

FROM scratch AS export_aphrodite
ARG COMMON_WORKDIR
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/dist/*.whl /
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/requirements /requirements
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/benchmarks /benchmarks
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/tests /tests
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/examples /examples
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/tools /tools
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile /docker/Dockerfile
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile.cpu /docker/Dockerfile.cpu
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile.rocm /docker/
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/docker/docker-bake.hcl /docker/docker-bake.hcl
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite/rust /rust


# -----------------------
# NIXL/UCX build stages
FROM base AS build_nixl
ARG NIXL_BRANCH="1683cf3b7f3d11674c03c5e861cea22339876c96"
ARG NIXL_REPO="https://github.com/ai-dynamo/nixl.git"
ARG UCX_BRANCH="96e58a16039f6d7d213bc967b8069238742c5194"
ARG UCX_REPO="https://github.com/openucx/ucx.git"
ENV ROCM_PATH=/opt/rocm
ENV UCX_HOME=/usr/local/ucx
ENV NIXL_HOME=/usr/local/nixl

RUN apt-get -y update && apt-get -y install --no-install-recommends \
    autoconf libtool pkg-config libgrpc-dev libgrpc++-dev libprotobuf-dev \
    protobuf-compiler-grpc libcpprest-dev libaio-dev librdmacm1 librdmacm-dev \
    libibverbs1 libibverbs-dev ibverbs-utils rdmacm-utils ibverbs-providers \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system meson meson-python pybind11 pyyaml types-PyYAML \
        auditwheel build patchelf pytest tomlkit "setuptools>=80.9.0"

RUN cd /usr/local/src \
    && git clone ${UCX_REPO} \
    && cd ucx \
    && git checkout ${UCX_BRANCH} \
    && ./autogen.sh \
    && mkdir build \
    && cd build \
    && ../configure \
        --prefix=/usr/local/ucx \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --enable-devel-headers \
        --with-rocm=${ROCM_PATH} \
        --with-verbs \
        --with-dm \
        --enable-mt \
    && make -j \
    && make install

ENV PATH=/usr/local/ucx/bin:$PATH
ENV LD_LIBRARY_PATH=${UCX_HOME}/lib:${LD_LIBRARY_PATH}

RUN git clone ${NIXL_REPO} /opt/nixl \
    && cd /opt/nixl \
    && git checkout ${NIXL_BRANCH} \
    && meson setup build --prefix=${NIXL_HOME} \
        -Ducx_path=${UCX_HOME} \
        -Dwheel_variant=rocm \
        -Dbuild_tests=false \
        -Dbuild_examples=false \
    && cd build \
    && ninja \
    && ninja install \
    && echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu" \
        > /etc/ld.so.conf.d/nixl.conf \
    && echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins" \
        >> /etc/ld.so.conf.d/nixl.conf \
    && ldconfig

# Generate the ROCm NIXL wheel. Upstream's generic wheel helper detects CUDA,
# so configure the ROCm wheel variant directly through Meson.
# Exclude libcore and libpull from auditwheel: transitive dependencies
# that are not shipped in the wheel and vary across base images.
# Tag manylinux_2_35 to match the Ubuntu 22.04 base: NIXL >= 1.5 links
# GLIBCXX_3.4.30 symbols, which manylinux_2_34 does not allow.
RUN cd /opt/nixl && \
    ./contrib/tomlutil.py --wheel-name nixl-rocm pyproject.toml && \
    CC="ccache gcc" CXX="ccache g++" \
    uv build --wheel --no-build-isolation --out-dir /tmp/nixl_wheels \
        --python ${PYTHON_VERSION} \
        -Csetup-args=-Ducx_path=${UCX_HOME} \
        -Csetup-args=-Dwheel_variant=rocm \
        -Csetup-args=-Dbuild_tests=false \
        -Csetup-args=-Dbuild_examples=false \
    && mkdir -p /tmp/nixl_wheels/repaired /app/install \
    && auditwheel repair \
        --exclude 'libamdhip64*' \
        --exclude 'libcore*' \
        --exclude 'libpull*' \
        /tmp/nixl_wheels/nixl_rocm*.whl \
        --plat manylinux_2_35_$(uname -m) \
        --wheel-dir /tmp/nixl_wheels/repaired && \
    ./contrib/wheel_add_ucx_plugins.py \
        --ucx-plugins-dir ${UCX_HOME}/lib/ucx \
        --nixl-plugins-dir ${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins \
        /tmp/nixl_wheels/repaired/*.whl \
    && cp /tmp/nixl_wheels/repaired/*.whl /app/install


# -----------------------
# DeepEP build stage
FROM base AS build_deep
ARG ROCSHMEM_BRANCH="ba0bf0f3"
ARG ROCSHMEM_REPO="https://github.com/ROCm/rocm-systems.git"
ARG DEEPEP_BRANCH="0f63d3e9"
ARG DEEPEP_REPO="https://github.com/ROCm/DeepEP.git"
ARG DEEPEP_NIC="cx7"
ENV ROCSHMEM_DIR=/opt/rocshmem

RUN git clone ${ROCSHMEM_REPO} \
    && cd rocm-systems \
    && git checkout ${ROCSHMEM_BRANCH} \
    && mkdir -p projects/rocshmem/build \
    && cd projects/rocshmem/build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX="${ROCSHMEM_DIR}" \
        -DROCM_PATH=/opt/rocm \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DUSE_EXTERNAL_MPI=OFF \
    && make -j \
    && make install

# Pass --rocm-gfx942-fp8-fnuz-max 224 to align the DeepEP dispatch FP8
# quantization bound with Aphrodite's own clamp
# (aphrodite/model_executor/layers/quantization/utils/fp8_utils.py): 224 for E4M3FNUZ.
RUN git clone ${DEEPEP_REPO} \
    && cd DeepEP \
    && git checkout ${DEEPEP_BRANCH} \
    && python3 setup.py --variant rocm --nic ${DEEPEP_NIC} --rocm-gfx942-fp8-fnuz-max 224 bdist_wheel --dist-dir=/app/deep_install


# -----------------------
# Aphrodite wheel release build stage. This stage is intended for ROCm wheel
# release jobs that provide custom ROCm dependency wheels in
# docker/context/base-wheels.
FROM fetch_aphrodite AS build_aphrodite_wheel_release

ARG COMMON_WORKDIR
ARG USE_SCCACHE
ARG SCCACHE_ENDPOINT
ENV APHRODITE_USE_PRECOMPILED_RUST=1
COPY --from=rust-build ${COMMON_WORKDIR}/aphrodite/aphrodite/aphrodite-rs aphrodite/aphrodite/aphrodite-rs
COPY --from=rust-build ${COMMON_WORKDIR}/aphrodite/aphrodite/_rust_*.so aphrodite/aphrodite/
RUN mkdir -p /install

COPY docker/context/base-wheels/ /tmp/base-wheels/
RUN if [ -n "$(ls /tmp/base-wheels/*.whl 2>/dev/null)" ]; then \
        echo "Found custom wheels - copying to /install"; \
        cp /tmp/base-wheels/*.whl /install/; \
        echo "Copied custom wheels:"; \
        ls -lh /install/; \
    else \
        echo "ERROR: No custom wheels found in docker/context/base-wheels/"; \
        echo "Wheel releases require pre-built ROCm wheels."; \
        exit 1; \
    fi

ARG GIT_REPO_CHECK=0
RUN if [ "$GIT_REPO_CHECK" != "0" ]; then \
        echo "Running repository checks..."; \
        cd aphrodite && bash tools/check_repo.sh; \
    fi

# Extract version from git before installing dependencies or modifying the tree.
RUN --mount=type=bind,source=.git,target=aphrodite/.git \
    cd aphrodite \
    && uv pip install --system setuptools_scm regex \
    && APHRODITE_VERSION=$(python3 -c "import setuptools_scm; print(setuptools_scm.get_version())") \
    && echo "Detected Aphrodite version: ${APHRODITE_VERSION}" \
    && echo "${APHRODITE_VERSION}" > /tmp/aphrodite_version.txt

RUN echo "Checking for git-based packages in requirements files..." \
    && echo "Checking common.txt for git-based packages:" \
    && if grep -q 'git+' ${COMMON_WORKDIR}/aphrodite/requirements/common.txt; then \
         echo "ERROR: Git-based packages found in common.txt:"; \
         grep 'git+' ${COMMON_WORKDIR}/aphrodite/requirements/common.txt; \
         echo "Please publish these packages to PyPI instead of using git dependencies."; \
         exit 1; \
       else \
         echo "  No git-based packages found in common.txt"; \
       fi \
    && echo "Checking rocm.txt for git-based packages:" \
    && if grep -q 'git+' ${COMMON_WORKDIR}/aphrodite/requirements/rocm.txt; then \
         echo "ERROR: Git-based packages found in rocm.txt:"; \
         grep 'git+' ${COMMON_WORKDIR}/aphrodite/requirements/rocm.txt; \
         echo "Please publish these packages to PyPI instead of using git dependencies."; \
         exit 1; \
       else \
         echo "  No git-based packages found in rocm.txt"; \
       fi

RUN --mount=type=cache,target=/root/.cache/uv \
    cd aphrodite \
    && echo "Building Aphrodite with custom wheels from /install" \
    && uv pip install --system --find-links /install -r requirements/rocm.txt \
    && python3 setup.py clean --all

RUN --mount=type=bind,source=.git,target=aphrodite/.git \
    --mount=type=secret,id=aws-credentials,target=/root/.aws/credentials,required=false \
    cd aphrodite \
    && if [ "$USE_SCCACHE" = "1" ]; then \
        if [ -n "${SCCACHE_ENDPOINT}" ]; then export SCCACHE_ENDPOINT="${SCCACHE_ENDPOINT}"; fi; \
        export RUSTC_WRAPPER=sccache; \
        sccache --show-stats; \
    fi \
    && export SETUPTOOLS_SCM_PRETEND_VERSION=$(cat /tmp/aphrodite_version.txt) \
    && export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_APHRODITE_ENGINE="${SETUPTOOLS_SCM_PRETEND_VERSION}" \
    && echo "Building wheel with version: ${SETUPTOOLS_SCM_PRETEND_VERSION}" \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then \
        sccache --show-stats; \
    fi

FROM scratch AS export_aphrodite_wheel_release
ARG COMMON_WORKDIR
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/dist/*.whl /
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/requirements /requirements
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/benchmarks /benchmarks
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/tests /tests
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/examples /examples
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/tools /tools
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile /docker/Dockerfile
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile.cpu /docker/Dockerfile.cpu
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/docker/Dockerfile.rocm /docker/
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/docker/docker-bake.hcl /docker/docker-bake.hcl
COPY --from=build_aphrodite_wheel_release ${COMMON_WORKDIR}/aphrodite/rust /rust


# -----------------------
# Test Aphrodite image
FROM base AS test

RUN python3 -m pip install --upgrade pip && rm -rf /var/lib/apt/lists/*

# Install Aphrodite using uv. No upgrade flag: avoid replacing ROCm PyTorch
# with CUDA wheels.
RUN --mount=type=bind,from=export_aphrodite,src=/,target=/install \
    --mount=type=cache,target=/root/.cache/uv \
    cd /install \
    && uv pip install --system -r requirements/rocm.txt \
    && uv pip install --system -r requirements/test/rocm.txt \
    && pip uninstall -y aphrodite-engine \
    && uv pip install --system *.whl

# Persist the built wheel in the image so python-only compile tests can
# reinstall it after removing compilers. The bind-mounted /install contents are
# not available once the RUN step completes.
COPY --from=export_aphrodite /*.whl /opt/aphrodite-wheels/

RUN --mount=type=bind,from=build_nixl,src=/app/install,target=/nixl_install \
    uv pip install --system /nixl_install/*.whl

RUN --mount=type=bind,from=build_deep,src=/app/deep_install,target=/deep_install \
    uv pip install --system /deep_install/*.whl
COPY --from=build_deep /opt/rocshmem /opt/rocshmem

# RDMA userspace libraries plus FFmpeg dev libs needed by torchcodec.
RUN timeout --kill-after=30s 5m apt-get update -q -y --error-on=any \
    -o Acquire::Retries=3 \
    -o Acquire::http::Timeout=30 \
    -o Acquire::https::Timeout=30 \
    && apt-get install -q -y --no-install-recommends \
    -o Acquire::Retries=3 \
    -o Acquire::http::Timeout=30 \
    -o Acquire::https::Timeout=30 \
    librdmacm1 \
    libibverbs1 \
    ibverbs-providers \
    ibverbs-utils \
    util-linux \
    unzip \
    libsodium23 \
    pkg-config ffmpeg libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libavdevice-dev libavfilter-dev libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /aphrodite-workspace
ARG COMMON_WORKDIR
COPY --from=build_aphrodite ${COMMON_WORKDIR}/aphrodite /aphrodite-workspace

RUN cd /aphrodite-workspace \
    && python3 -m pip install -e tests/aphrodite_test_utils \
    && python3 -m pip install pytest-shard

ENV HF_XET_HIGH_PERFORMANCE=1
ENV HF_HUB_DOWNLOAD_TIMEOUT=60

# Use legacy IPC mode for HSA to avoid GPU memory pinning issues with UCX rocm_ipc.
ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV UCX_RMA_PPLN_ENABLE=y
ENV UCX_ROCM_COPY_SIGPOOL_MAX_ELEMS=inf

# Source code is used in python-only compile tests. Hide it inside src/ so it
# will not be imported by other tests.
RUN mkdir src && mv aphrodite src/aphrodite

RUN printf '%s\n' \
    'import os' \
    '' \
    '_exit_code = 1' \
    '' \
    'def pytest_sessionfinish(session, exitstatus):' \
    '    global _exit_code' \
    '    _exit_code = int(exitstatus)' \
    '' \
    'def pytest_unconfigure(config):' \
    '    import sys' \
    '    sys.stdout.flush()' \
    '    sys.stderr.flush()' \
    '    os._exit(_exit_code)' \
    > /aphrodite-workspace/conftest.py


# -----------------------
# Final Aphrodite image
FROM base AS final

RUN python3 -m pip install --upgrade pip && rm -rf /var/lib/apt/lists/*

RUN rm -f /usr/bin/sccache || true \
    && rm -rf /opt/sccache-wrappers || true

ENV SCCACHE_BUCKET=
ENV SCCACHE_REGION=
ENV SCCACHE_S3_NO_CREDENTIALS=
ENV SCCACHE_IDLE_TIMEOUT=

# Error related to odd state for numpy 1.20.3 where there is no METADATA etc,
# but an extra LICENSES_bundled.txt. Manually remove it so later numpy upgrades
# can continue.
RUN case "$(which python3)" in \
        *"/opt/conda/envs/py_3.9"*) \
            rm -rf /opt/conda/envs/py_3.9/lib/python3.9/site-packages/numpy-1.20.3.dist-info/;; \
        *) ;; esac

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --upgrade huggingface-hub

# Install Aphrodite using uv. No upgrade flag: avoid replacing ROCm PyTorch
# with CUDA wheels.
RUN --mount=type=bind,from=export_aphrodite,src=/,target=/install \
    --mount=type=cache,target=/root/.cache/uv \
    cd /install \
    && uv pip install --system -r requirements/rocm.txt \
    && pip uninstall -y aphrodite-engine \
    && uv pip install --system *.whl

# Install NIXL ROCm wheel.
RUN --mount=type=bind,from=build_nixl,src=/app/install,target=/nixl_install \
    uv pip install --system /nixl_install/*.whl

ARG COMMON_WORKDIR
ARG BASE_IMAGE

COPY --from=export_aphrodite /benchmarks ${COMMON_WORKDIR}/aphrodite-engine/benchmarks
COPY --from=export_aphrodite /examples ${COMMON_WORKDIR}/aphrodite-engine/examples
COPY --from=export_aphrodite /docker ${COMMON_WORKDIR}/aphrodite-engine/docker

ENV RAY_EXPERIMENTAL_NOSET_ROCR_VISIBLE_DEVICES=1
ENV TOKENIZERS_PARALLELISM=false
ENV SAFETENSORS_FAST_GPU=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV UCX_RMA_PPLN_ENABLE=y
ENV UCX_ROCM_COPY_SIGPOOL_MAX_ELEMS=inf

RUN echo "ROCTRACER_MAX_EVENTS=10000000" > ${COMMON_WORKDIR}/libkineto.conf
ENV KINETO_CONFIG="${COMMON_WORKDIR}/libkineto.conf"

RUN echo "APHRODITE_BASE_IMAGE=${BASE_IMAGE}" >> ${COMMON_WORKDIR}/versions.txt

CMD ["/bin/bash"]

# Set entrypoint for Aphrodite OpenAI-compatible serving images.
FROM final AS aphrodite-openai
ENTRYPOINT ["aphrodite", "run"]
