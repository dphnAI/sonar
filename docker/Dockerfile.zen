# This Dockerfile builds AMD Zen CPU images for Sonar with zentorch.
# It layers on top of the CPU image produced by docker/Dockerfile.cpu.
#
# Supported platforms:
#   - linux/amd64 (Zen2 and newer; Zen5 is the canonical CI target)
#
# Build targets:
#   sonar-openai-zen (default): Sonar + zentorch for serving
#   sonar-zen-test            : sonar-openai-zen + test deps for CI
#
# Build workflow (see .buildkite/image_build/image_build_zen_cpu.sh):
#   1. Obtain a CPU base image that already has Sonar installed. In CI this is the
#      shared `<repo>:<commit>-cpu` image (docker/Dockerfile.cpu --target
#      sonar-test); either the sonar-test or sonar-openai target works as the base
#      since both install Sonar into the same venv this stage extends.
#   2. docker build -f docker/Dockerfile.zen --build-arg BASE_IMAGE=<base>:<tag> \
#                    --target sonar-zen-test -t <out>:<tag> .

ARG BASE_IMAGE
ARG PYTHON_VERSION=3.12
ARG ZENTORCH_VERSION

######################### ZEN OPENAI IMAGE #########################
FROM ${BASE_IMAGE} AS sonar-openai-zen

ARG TARGETARCH
ARG ZENTORCH_VERSION

RUN if [ "${TARGETARCH}" != "amd64" ]; then \
        echo "ERROR: Dockerfile.zen requires --platform=linux/amd64"; \
        exit 1; \
    fi

WORKDIR /sonar-workspace

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "${ZENTORCH_VERSION}" ]; then \
        uv pip install "zentorch==${ZENTORCH_VERSION}"; \
    else \
        uv pip install "sonar[zen]" \
            --extra-index-url https://sonar.dphn.ai/whl/release/cpu/x86_64/simple \
            --index-strategy first-index; \
    fi

LABEL org.opencontainers.image.title="Sonar Zen CPU"
LABEL org.opencontainers.image.description="Sonar with zentorch for AMD Zen CPUs"
LABEL org.opencontainers.image.vendor="Sonar Project"
LABEL org.opencontainers.image.source="https://github.com/dphnAI/sonar"
LABEL ai.sonar.build.target-arch="${TARGETARCH}"
LABEL ai.sonar.build.python-version="${PYTHON_VERSION}"
LABEL ai.sonar.build.zentorch-version="${ZENTORCH_VERSION:-unpinned}"

ENTRYPOINT ["sonar", "run"]

######################### ZEN TEST IMAGE #########################
FROM sonar-openai-zen AS sonar-zen-test

WORKDIR /sonar-workspace

COPY requirements/common.txt requirements/common.txt
COPY requirements/test/cuda.in requirements/test/zen.in

RUN sed -i '/mamba_ssm/d'                  requirements/test/zen.in && \
    sed -i 's/^torch==.*/torch==2.14.0/g'  requirements/test/zen.in && \
    sed -i 's/torchaudio.*/torchaudio/g'   requirements/test/zen.in && \
    sed -i 's/torchvision.*/torchvision/g' requirements/test/zen.in && \
    # zentorch parity: keep sentence-transformers pinned where sonar-test-deps did.
    sed -i 's/^sentence-transformers.*/sentence-transformers==5.3.0/g' requirements/test/zen.in && \
    uv pip compile requirements/test/zen.in \
       -o requirements/test/zen.txt \
       --index-strategy unsafe-best-match --torch-backend cpu

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r requirements/test/zen.txt --torch-backend cpu

# Reassert zentorch's torch in case test-deps moved it.
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "${ZENTORCH_VERSION}" ]; then \
        uv pip install --force-reinstall --no-deps "zentorch==${ZENTORCH_VERSION}"; \
    else \
        uv pip install --force-reinstall --no-deps "sonar[zen]" \
            --extra-index-url https://sonar.dphn.ai/whl/release/cpu/x86_64/simple \
            --index-strategy first-index; \
    fi

ADD ./tests/ ./tests/
ADD ./examples/ ./examples/
ADD ./benchmarks/ ./benchmarks/
ADD ./sonar/collect_env.py .
ADD ./docker/ ./docker/
ADD ./.buildkite/ ./.buildkite/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -e tests/sonar_test_utils

ENV HF_XET_HIGH_PERFORMANCE=1
ENV HF_HUB_DOWNLOAD_TIMEOUT=60

ENTRYPOINT []